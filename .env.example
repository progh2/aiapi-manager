# 실제 값을 채워서 .env로 복사해 사용 (cp .env.example .env)
# .env는 절대 git에 커밋하지 말 것

# OpenAI 실제 API 키 (학생에게 노출되지 않음)
OPENAI_API_KEY=sk-...

# LiteLLM 관리자 마스터 키. "sk-"로 시작해야 함. 예: sk- 뒤에 랜덤 문자열
# 생성 예: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-change-me

# Postgres 비밀번호 (내부 네트워크 전용이지만 강하게)
POSTGRES_PASSWORD=change-me

# --- 관리자 UI (Firebase 구글 로그인) ---
# Firebase 콘솔 → 프로젝트 설정 → 웹 앱
FIREBASE_PROJECT_ID=my-firebase-project
FIREBASE_API_KEY=AIzaSy...
# 비우면 ${FIREBASE_PROJECT_ID}.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
# 관리자로 허용할 구글 계정 (쉼표 구분). 그 외는 관리자 화면에서 등록한 계정만 로그인
ADMIN_EMAILS=progh2@gmail.com

# --- 포트 (기존 서비스와 겹치면 변경) ---
# litellm 은 NAS 네트워크에 바로 붙어 이 포트를 NAS 에서 직접 연다(학생 PC 의 실제 IP 를 기록하려고).
LITELLM_PORT=4000
ADMIN_UI_PORT=3000
# DB 를 NAS 자신(127.0.0.1)에만 여는 포트. 학교 망에서는 닿지 않는다. 겹치면 바꾼다.
POSTGRES_HOST_PORT=15432

# --- 학생 안내·LiteLLM 화면 ---
# 학생 코드의 base_url. 비우면 관리 화면에 접속한 주소 + LITELLM_PORT (예: http://192.168.0.10:4000)
PUBLIC_PROXY_URL=
# LiteLLM 자체 관리 화면(http://NAS:4000/ui). 관리 화면이 대신하므로 기본으로 끈다. 켜려면 False
LITELLM_DISABLE_ADMIN_UI=True
